{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "store-ops-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: the pg driver. global_fetch_strictly_public: required by the OAuth
  // provider before it fetches Client ID Metadata Documents (SSRF protection).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "vars": {
    // Replace with the deployed origin. Local dev uses .dev.vars instead.
    "PUBLIC_BASE_URL": "http://localhost:8787",
    // Most new demo users (each with a Demo Store) per UTC day, across all clients.
    "DEMO_DAILY_CAP": "200",
  },
  // "Try the demo": 5 new demos per client address per minute, per Cloudflare location
  // (approximate by design; the daily cap above is the exact bound). Period must be 10 or 60.
  "ratelimits": [
    {
      "name": "DEMO_LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // Hourly: wipe expired demo stores (audit_log stays) and sweep expired OAuth data.
  "triggers": { "crons": ["17 * * * *"] },
  "kv_namespaces": [
    // Created at deploy time (after approval). Local dev uses a local simulated namespace.
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Created at deploy time (after approval), pointing at Neon.
      "id": "00000000000000000000000000000000",
      // Local dev: the compose.yaml Postgres with a store_ops_dev database (see README), reached
      // by the login role that is only a member of store_ops_app. Throwaway credentials.
      "localConnectionString": "postgres://store_ops_login:store_ops_login_local@localhost:54329/store_ops_dev",
    },
  ],
}
