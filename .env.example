# Local demo user id (UUID). Optional.
STORE_OPS_USER_ID=00000000-0000-4000-8000-000000000001
# Local PGlite data directory. Optional.
STORE_OPS_DATA_DIR=.data/pglite
# Folder where `pnpm approve` leaves decisions for the running stdio server. Optional.
STORE_OPS_APPROVALS_DIR=.data/approvals
# Base URL of the approval page; links are <base>/approve/<id>. Optional.
STORE_OPS_APPROVAL_BASE_URL=http://localhost:8787
# Stripe TEST MODE secret key. Optional. Leave empty to refund demo orders with the built-in
# fake processor. Demo orders carry fake payment references (pi_demo_...), so with a key set
# only orders paid with a real Stripe test PaymentIntent can be refunded. Any key that does not
# start with sk_test_ is refused.
STRIPE_SECRET_KEY=
